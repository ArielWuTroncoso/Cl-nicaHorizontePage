# ==========================================
# Centro Odontológico Horizonte - Variables de entorno
# ==========================================

# --- Base de datos ---
# Desarrollo local (H2 en memoria, no requiere instalar nada):
DB_URL=jdbc:h2:mem:horizonte;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Produccion (PostgreSQL en Render o Neon):
# DB_URL=jdbc:postgresql://HOST:5432/horizonte?sslmode=require
# DB_USER=horizonte
# DB_PASSWORD=cambiar
# DB_DRIVER=org.postgresql.Driver

# --- JPA / Flyway ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=false

# --- Seguridad JWT ---
JWT_SECRET=6B59703373367639792F423F4528482B4D6251655468576D5A7134743777217A
JWT_EXPIRATION=86400000

# --- Administración ---
# Código que se pide al registrar un administrador. Si queda vacío, el registro
# está cerrado. Usa uno largo: openssl rand -base64 24
ADMIN_REGISTRO_CODIGO=
# Opcional: crea una cuenta de administración al iniciar (si no hay clave, no se crea).
SEED_ADMIN_CORREO=admin@horizonte.local
SEED_ADMIN_CLAVE=

# --- CORS: origenes del frontend, separados por coma, sin barra final ---
FRONTEND_ORIGINS=http://localhost:5173,https://horizonte-frontend.onrender.com

SEED_ENABLED=true

# --- Puerto ---
PORT=8080

# --- Frontend (Vite) ---
# Vacío si el SPA se sirve embebido en Spring Boot.
# En despliegue separado: https://horizonte-backend.onrender.com
VITE_API_URL=
